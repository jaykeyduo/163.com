{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dg-export-audit-rules.schema.json",
  "title": "危险品出口审核工具规则库 Schema",
  "description": "V1.0 演示规则结构。字段值不得直接视为正式 IMDG 法规数据。",
  "type": "object",
  "required": ["meta", "unRules", "specialProvisions", "packages"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "ruleVersion", "regulationVersion", "status", "effectiveDate", "sourceReference"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "ruleVersion": { "type": "string" },
        "regulationVersion": { "type": "string" },
        "enterpriseRuleVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["DEMO", "DRAFT", "APPROVED"] },
        "effectiveDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": "string", "format": "date" },
        "sourceReference": { "type": "string" },
        "disclaimer": { "type": "string" }
      }
    },
    "eqCodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inner": {},
          "outer": {},
          "note": { "type": "string" }
        }
      }
    },
    "specialProvisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["code", "title", "applicability", "handling", "citation"],
        "properties": {
          "code": { "type": "string" },
          "title": { "type": "string" },
          "applicability": { "type": "string" },
          "requiredInputs": { "type": "array", "items": { "type": "string" } },
          "handling": { "type": "string" },
          "citation": { "type": "string" },
          "enterpriseNote": { "type": "string" }
        }
      }
    },
    "unRules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["unNumber", "properShippingName", "class", "packingGroups", "specialProvisions", "packingInstruction", "status"],
        "properties": {
          "unNumber": { "type": "string" },
          "properShippingName": { "type": "string" },
          "properShippingNameZh": { "type": "string" },
          "class": { "type": "string" },
          "subsidiaryRisk": { "type": "string" },
          "packingGroups": { "type": "array", "items": { "type": "string" } },
          "specialProvisions": { "type": "array", "items": { "type": "string" } },
          "lqByPg": { "type": "object" },
          "eqByPg": { "type": "object" },
          "packingInstruction": { "type": "string" },
          "ems": { "type": "string" },
          "marinePollutantDefault": { "type": "boolean" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "sourceReference": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packageId", "unPackageCode", "performanceRating", "effectiveStatus"],
        "properties": {
          "packageId": { "type": "string" },
          "name": { "type": "string" },
          "unPackageCode": { "type": "string" },
          "material": { "type": "string" },
          "closure": { "type": "string" },
          "performanceRating": { "type": "string", "enum": ["X", "Y", "Z"] },
          "capacityL": { "type": "number" },
          "maxGrossKg": { "type": "number" },
          "maxRelativeDensity": { "type": "number" },
          "testPressureKPa": { "type": "number" },
          "compatibilityStatus": { "type": "string" },
          "performanceCertificate": { "type": "string" },
          "useAppraisalScope": { "type": "string" },
          "effectiveStatus": { "type": "string" }
        }
      }
    },
    "pgPerformanceMap": {
      "type": "object",
      "description": "货物包装等级 → 最低可接受包装性能等级"
    }
  }
}
