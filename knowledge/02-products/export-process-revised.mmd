%% 出口 UN 包装主流程 — 修订版
%% 对齐：ByRoy 现图 ExportProcess_ByRoy.jpg + Phase I/II 纪要
%% 冲突规则：Phase II 优先；无冲突沿用 Phase I / 保留 ByRoy 已有正确节点

flowchart TB
  subgraph P0["Phase 0 主数据（采购常驻维护）"]
    S2["S2 / Standard toolbox<br/>采购维护｜一料号一条记录<br/>默认浙江新材料抬头申请"]
    S3["S3 包装及性能单信息汇总<br/>采购及时维护｜独山抬头<br/>自然年申请｜4位编码↔桶形1:1"]
  end

  subgraph P1["Phase 1 需求澄清 + 包装锁定"]
    A1["PC：Request"]
    A2["Define product（10 Digit）"]
    A3["填 S1 = Export Request Sheet<br/>Product + Package<br/>Francis补齐采购字段"]
    A4["采购：Provide UN requirements"]
    A5["实验室：composition / viscosity / density"]
    A6["Order Clearing：SDS / Label"]
    A7["采购：Advise Export Package<br/>读 S2 Standard toolbox"]
    A8{"Check if meet requirements?"}
    A9["New Package Assessment<br/>默认 Not recommend"]
    A10["Confirm Export Request Sheet<br/>出口桶码 ≠ 内贸桶码"]
    A11{"出口部：是否该国首次出口？"}
    A12["标注海关检测 Lead-time<br/>反馈业务/计划"]
    A13["常规 Lead-time"]
    A14["采购核对 S3：性能单/库存/料号唯一"]
    A15{"性能单/包装是否足够？"}
    A16["采购申请/下单包装<br/>供应商贴 UN+年份"]
    A17["包装锁定 → 通知计划/生产/物流"]
    A18["实验室：Apply 13 Digit of Product"]
  end

  subgraph P2["Phase 2 计划与仓库备料"]
    B1["MP：Prepare Filling Order<br/>Export tin code 单独区分"]
    B2["MP：排产 Milestone 含出口 Lead-time"]
    B3["仓库收货 UN 包装<br/>核对 UN/年份/料号"]
    B4{"大口盖切换？"}
    B5["新旧盖物理隔离<br/>新盖存 3 号仓"]
    B6{"小口桶新 UN 到货？"}
    B7["仓邮件通知生产<br/>生产报废旧小口库存"]
    B8["库存可用 · 供产叫料"]
  end

  subgraph P3["Phase 3 生产罐装与合规"]
    C1["PC：Confirm demand / Sales Order"]
    C2["MP：Production Order & Filling Order"]
    C3["生产：按罐装单备注的 UN 号<br/>取对应 UN 桶罐装"]
    C4["QC result OK<br/>SAP 生产日期精确到日"]
    C5{"本票需危包证/相容性？"}
    C6["实验室或第三方<br/>产品-包装相容性自检"]
    C7["Logistic：Storage"]
  end

  subgraph P4["Phase 4 报关出运（保留 ByRoy 末段）"]
    D1["Order customs inspection"]
    D2{"1st time?"}
    D3["1st time export test process"]
    D4["Shipping Label Labelling"]
    D5["Export Inspection"]
    D6["Delivery & Vessel Booking"]
    D7["END"]
  end

  subgraph Y["年度切换子流程（并行）"]
    Y1["年底：采购组织新老 UN 切换会"]
    Y2["采购邮件通知 计划/生产/物流"]
    Y3["执行大口隔离 / 小口报废规则"]
    Y4["更新 S2/S3 新年度记录"]
  end

  S2 --> A7
  S3 --> A14
