  B4 -->|否| B6
  B6 -->|是| B7 --> B8
  B6 -->|否| B8
  B8 --> C1 --> C2 --> C3 --> C4 --> C5
  C5 -->|是| C6 --> C7
  C5 -->|否| C7
  C7 --> D1 --> D2
